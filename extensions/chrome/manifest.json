{
    "manifest_version": 3,
    "name": "RepGen Assistant",
    "version": "1.0",
    "description": "Reproduce Deep Learning Bugs directly from GitHub Issues",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://github.com/*",
        "http://localhost:8000/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://github.com/*/*/issues/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    }
}