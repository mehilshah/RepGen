{
    "name": "repgen-vscode",
    "displayName": "RepGen",
    "description": "Automated Deep Learning Bug Reproduction",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "repgen.reproduce",
                "title": "RepGen: Reproduce Bug"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "repgen-sidebar-view",
                    "title": "RepGen",
                    "icon": "$(bug)"
                }
            ]
        },
        "views": {
            "repgen-sidebar-view": [
                {
                    "type": "webview",
                    "id": "repgen-sidebar",
                    "name": "RepGen Automation",
                    "icon": "$(bug)"
                }
            ]
        },
        "configuration": {
            "title": "RepGen",
            "properties": {
                "repgen.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Your API Key for LLM Backend (e.g. OpenAI)"
                },
                "repgen.model": {
                    "type": "string",
                    "default": "gpt-4o",
                    "description": "Model to use for reproduction (e.g. gpt-4o, claude-3-5-sonnet)"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/node": "18.x",
        "@typescript-eslint/eslint-plugin": "^6.4.1",
        "@typescript-eslint/parser": "^6.4.1",
        "eslint": "^8.47.0",
        "typescript": "^5.1.6"
    },
    "dependencies": {
        "axios": "^1.6.0"
    }
}